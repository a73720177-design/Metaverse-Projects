# 공통 상태 점검용 공개 주소입니다. 비밀번호와 API 키를 넣지 않습니다.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
LLM_URL=http://localhost:8001
OLLAMA_URL=http://localhost:11434
CHECK_TIMEOUT_SECONDS=5

# 쉼표로 구분한 서비스만 종료 코드 판정에 사용합니다.
# 전체 통합 검증 시 frontend,backend,llm,ollama,postgresql,minio를 유지합니다.
REQUIRED_SERVICES=frontend,backend,llm,ollama,postgresql,minio

# TCP 연결 확인용 주소입니다. 비밀번호는 입력하지 않습니다.
DB_HOST=
DB_PORT=5432
MINIO_ENDPOINT=localhost:9000
