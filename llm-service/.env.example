# 이 파일을 .env로 복사한 뒤 필요시 값을 수정하세요.
# .env는 git에 커밋하지 않습니다 (.gitignore에 이미 포함).

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Optional smaller model for latency-sensitive chat. Falls back to OLLAMA_MODEL.
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REVIEW_MODEL=qwen3:4b
OLLAMA_QUESTION_MODEL=qwen3:4b
OLLAMA_SUMMARY_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3
# /api/v1/embeddings가 Ollama /api/embed를 호출할 때 한 번에 보내는 텍스트 개수.
OLLAMA_EMBED_BATCH=32
OLLAMA_KEEP_ALIVE=2m
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_TIMEOUT=2000
LLM_MAX_CONCURRENT_GENERATIONS=3

# 리뷰 생성 map-reduce 청킹. 문서 길이가 REVIEW_SINGLE_PASS_CHARS를 넘으면
# REVIEW_CHUNK_CHARS 단위로 잘라 최대 REVIEW_MAX_MAP_CALLS개 그룹으로 묶어
# claim만 추출(map)한 뒤 한 번에 정리(reduce)한다.
REVIEW_SINGLE_PASS_CHARS=12000
REVIEW_CHUNK_CHARS=3000
REVIEW_MAP_CHARS=12000
REVIEW_MAX_MAP_CALLS=6

# 요약 생성 map-reduce 청킹. 문서 길이가 SUMMARY_SINGLE_PASS_CHARS를 넘으면
# SUMMARY_CHUNK_CHARS 단위로 잘라 최대 SUMMARY_MAX_MAP_CALLS개 그룹으로 묶어
# 핵심 요점만 추출(map)한 뒤 한 번에 정리(reduce)한다.
SUMMARY_SINGLE_PASS_CHARS=12000
SUMMARY_CHUNK_CHARS=3000
SUMMARY_MAP_CHARS=12000
SUMMARY_MAX_MAP_CALLS=6

# 16GB RAM에서 qwen3:4b 하나를 공유해 최대 3개 요청을 병렬 처리합니다.
LLM_MAX_MODEL_LEN=4096
LLM_CONTEXT_SAFETY_TOKENS=512
LLM_APPROX_CHARS_PER_TOKEN=2.0
# 채팅 프롬프트에 넣는 이전 대화 블록의 최대 글자 수. 넘치면 오래된 턴부터 자릅니다.
CHAT_HISTORY_MAX_CHARS=2000

# vLLM 전환 시 LLM_PROVIDER=vllm으로 변경합니다. API key는 선택이지만
# 다른 장비에서 접근할 수 있다면 reverse proxy와 함께 반드시 보호합니다.
VLLM_BASE_URL=http://localhost:8002
VLLM_MODEL=
VLLM_API_KEY=
VLLM_QUANTIZATION=
# 예시 서빙 조정값(실제 CLI에 전달):
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=4
VLLM_KV_CACHE_DTYPE=auto
