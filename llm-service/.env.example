# 이 파일을 .env로 복사한 뒤 필요시 값을 수정하세요.
# .env는 git에 커밋하지 않습니다 (.gitignore에 이미 포함).

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Optional smaller model for latency-sensitive chat. Falls back to OLLAMA_MODEL.
OLLAMA_CHAT_MODEL=
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_TIMEOUT=300
