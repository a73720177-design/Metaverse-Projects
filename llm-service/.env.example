# 이 파일을 .env로 복사한 뒤 필요시 값을 수정하세요.
# .env는 git에 커밋하지 않습니다 (.gitignore에 이미 포함).

OLLAMA_HOST=http://localhost:11434
# 추론(think)용 - 최초 평가, 채팅 피드백
OLLAMA_MODEL=qwen3:8b
# 경량(무추론)용 - 페르소나 생성, 인사말 응답
OLLAMA_CHAT_MODEL=qwen3:4b
# 임베딩(RAG) - 모든 답변 경로가 생성 전에 이 모델로 자료를 검색합니다.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_TIMEOUT=300
# KV 캐시가 num_ctx에 비례해 VRAM을 먹습니다. Ollama 서버에도
# OLLAMA_NUM_PARALLEL=1, OLLAMA_MAX_LOADED_MODELS=3을 설정하세요.
OLLAMA_NUM_CTX=8192
OLLAMA_EMBED_BATCH=64

# RAG 검색 설정
RAG_TOP_K=5
RAG_REVIEW_TOP_K=12
# 코사인 유사도가 이 값 미만이면 생성 없이 "자료를 추가해 달라"고 응답합니다.
RAG_SIMILARITY_THRESHOLD=0.45
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_CACHE_DIR=.rag_cache
RAG_CACHE_DOCS=32
