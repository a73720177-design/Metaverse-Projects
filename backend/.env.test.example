# 실제 공유 DB가 아닌 별도 테스트 DB만 사용합니다.
TEST_DATABASE_URL=postgresql+asyncpg://사용자:비밀번호@localhost:5432/qwendb_test

# 위 계정으로 DB 생성 권한이 없거나 관리 DB 주소가 다를 때만 설정합니다.
# 지정하지 않으면 TEST_DATABASE_URL과 같은 서버의 postgres DB를 사용합니다.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://사용자:비밀번호@localhost:5432/postgres

# MinIO 통합 테스트를 추가할 때 사용하는 별도 bucket입니다.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents-test
MINIO_SECURE=false
