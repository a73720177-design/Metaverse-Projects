LLM_SERVICE_URL=http://localhost:8001
# 현재 LLM 팀 코드와 연결: legacy_questions
# LLM 팀이 /api/v1/personas, /reviews, /chat을 구현한 뒤: v1
LLM_CONTRACT_MODE=legacy_questions
# Development only: keep Persona creation usable when a local model emits invalid JSON.
PERSONA_FALLBACK_LOCAL=false
LLM_API_PREFIX=/api/v1
LLM_SERVICE_TIMEOUT=300

# 기본값은 외부 인프라 없이 실행되는 개발 모드입니다.
REPOSITORY_MODE=memory
OBJECT_STORAGE_MODE=local
DB_AUTO_CREATE=false
LOCAL_STORAGE_DIR=
MAX_UPLOAD_SIZE_MB=25
RAG_MAX_CONTEXT_CHARS=4000
# DB 팀의 pgvector 마이그레이션이 적용된 PostgreSQL 환경에서만 vector로 전환합니다.
RAG_MODE=lexical
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=8
VECTOR_RAG_CANDIDATE_K=12
VECTOR_RAG_FINAL_K=6
# pgvector cosine distance 기준. 실제 발표자료 평가셋으로 조정합니다.
VECTOR_RAG_MAX_DISTANCE=0.65
# DocumentContextSelector의 lexical 청킹 인메모리 캐시 크기(문서 수 기준).
CHUNK_CACHE_SIZE=32

# 답변-근거 검증(grounding). off: 검증 안 함. annotate: 검증해서 결과만 응답에 첨부.
# strict: annotate + 점수가 GROUNDING_MIN_SCORE 미만이면 답변 끝에 경고 문구를 덧붙임.
GROUNDING_MODE=off
GROUNDING_THRESHOLD=0.35
GROUNDING_MIN_SCORE=0.5

# 쉼표로 구분합니다. 마지막에 /를 붙이지 않습니다.
# React(CRA/Vite), Vite preview, VS Code Live Server 기본 포트 예시입니다.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Hamachi(25.x.x.x)에서 공유하는 Vite dev/preview 서버만 추가 허용합니다.
# 정규식 허용이 필요 없으면 빈 값으로 설정합니다.
FRONTEND_ORIGIN_REGEX=^http://25(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3}:(?:4173|5173)$

# PostgreSQL 실제 값은 로컬 .env에만 입력합니다.
DB_HOST=
DB_PORT=5432
DB_NAME=qwendb
DB_USER=
DB_PASSWORD=
DATABASE_URL=
# postgres 모드에서는 번호 migration을 먼저 적용하고 false를 유지합니다.
# DB_AUTO_CREATE는 빈 개발 DB용 보조 기능이며 기존 테이블을 migration하지 않습니다.

# 로컬 로그인 설정입니다. 실제 값은 32바이트 이상의 임의 문자열을 사용합니다.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_HISTORY_TURNS=6
CHAT_OUTPUT_TOKENS_CONCISE=512
CHAT_OUTPUT_TOKENS_STANDARD=1024
CHAT_OUTPUT_TOKENS_DETAILED=1024
CHAT_OUTPUT_TOKENS_MAX=1024

# MinIO 실제 키는 로컬 .env에만 입력합니다.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false
