LLM_SERVICE_URL=http://localhost:8001
LLM_API_PREFIX=/api/v1
LLM_SERVICE_TIMEOUT=300

# 쉼표로 구분합니다. 마지막에 /를 붙이지 않습니다.
# React(CRA/Vite), Vite preview, VS Code Live Server 기본 포트 예시입니다.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Hamachi(25.x.x.x)에서 공유하는 Vite dev/preview 서버만 추가 허용합니다.
# 정규식 허용이 필요 없으면 빈 값으로 설정합니다.
FRONTEND_ORIGIN_REGEX=^http://25(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3}:(?:4173|5173)$
